{
  "manifest_version": 3,
  "name": "Jeff Browser Companion",
  "version": "0.1.0",
  "description": "A local-first, user-controlled browser companion for Jeff.",
  "browser_specific_settings": {
    "gecko": {
      "id": "jeff-companion@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["personalCommunications", "websiteContent"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "512": "icons/icon-512.png"
  },
  "permissions": ["activeTab", "scripting", "storage", "alarms", "notifications"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "background": { "scripts": ["logic.js", "background.js"] },
  "action": {
    "default_title": "Open Jeff on this page",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "web_accessible_resources": [{
    "resources": ["icons/jeff-icon.svg"],
    "matches": ["<all_urls>"]
  }],
  "incognito": "not_allowed"
}
